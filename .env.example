# Base RPC (Alchemy, QuickNode, or public fallback)
BASE_RPC_URL=https://mainnet.base.org

# PostgreSQL (Neon recommended for Vercel)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# API auth (local dev only — NEVER set in production)
DEV_API_KEY=dev_local_key_change_me

# Required in production (set APP_ENV=production explicitly)
APP_ENV=development
API_KEY_PEPPER=change_me_to_a_long_random_secret
DASHBOARD_SESSION_SECRET=change_me_to_a_long_random_secret
ADMIN_SECRET=change_me_for_global_blacklist_admin

# Which forwarded-IP header may be believed (per-IP rate limits depend on it).
#   vercel  — x-vercel-forwarded-for only (correct ONLY when deployed on Vercel)
#   generic — x-real-ip / x-forwarded-for only, and only behind a proxy that rewrites them
#   none    — believe nothing; every caller shares one bucket (safe default)
PROXY_HEADER_SOURCE=none
# Deprecated (2026-08-22): TRUST_PROXY_HEADERS / TRUST_GENERIC_FORWARDED_FOR.
# Still read when PROXY_HEADER_SOURCE is unset, but they cannot say WHICH header
# is trustworthy — off Vercel that guess made every IP limit bypassable.

# Cron auth (Vercel cron + manual triggers)
CRON_SECRET=change_me_cron_secret_min_32_chars

# Optional: separate RPC for batch indexers (falls back to BASE_RPC_URL)
# INDEXER_RPC_URL=https://base-mainnet.g.alchemy.com/v2/...

# Deep health flags indexer lag above N blocks (informational; does not force HTTP 503)
# HEALTH_INDEXER_LAG_BLOCKS=500000

# Closed beta: require invite code on /signup (omit for public beta)
# BETA_INVITE_CODE=your-secret-invite

# Public URL for Stripe redirects
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (public beta)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_SCALE=price_...

# Optional: skip on-chain reads in local dev (NEVER enable in production)
SKIP_CHAIN_READS=false

# eth_getLogs block range per RPC request (default 2000; raise if your RPC allows)
# GET_LOGS_CHUNK_BLOCKS=2000
# Optional delay between chunks (ms) for public RPC rate limits
# GET_LOGS_CHUNK_DELAY_MS=250

# Blockscout API for wallet history (Base mainnet)
BLOCKSCOUT_API_URL=https://base.blockscout.com/api
# BLOCKSCOUT_API_KEY=

# MCP server / x402 examples
VOUCH_API_URL=http://localhost:3000/api/v1
# VOUCH_API_KEY=vouch_live_...

# --- Observatory L1 (real purchases) — both OFF by default; enabling spends real funds ---
# OBSERVATORY_L1_ENABLED=true
# OBSERVATORY_WALLET_PRIVATE_KEY=0x...
# /playground の level:l1（デモ実購入）。観測所側フラグと二重ゲート。
# DEMO_L1_ENABLED=true

# --- On-chain publication & attestations — all OFF by default; enabling spends gas/fees ---
# REGISTRY_WRITES_ENABLED=true
# REGISTRY_OPERATOR_PRIVATE_KEY=0x...   # separate key from the purchase wallet
# REGISTRY_MAX_FEE_GWEI=0.5
# 有効化前の見積もり（読み取り専用・鍵不要）: DATABASE_URL=... npm run registry:dry-run  → 日次候補件数・1件あたりガス・7日合計・上限案をJSONで出す
# SOLANA_ATTEST_ENABLED=true
# ANCHOR_WRITES_ENABLED=true
# --- Permissionless contribution intake (Phase 3.3 v0) ---
# CONTRIBUTIONS_ENABLED=true

# --- Outbound mail (Resend HTTP API) — record subscriptions / disputes (2026-09-02) ---
# Both unset = nothing is sent; subscriptions are still recorded and the cron logs mail_unset.
# RESEND_API_KEY=re_...
# MAIL_FROM=vet402 <records@vet402.com>
