# Base RPC (Alchemy, QuickNode, or public fallback)
BASE_RPC_URL=https://mainnet.base.org

# PostgreSQL (Neon recommended for Vercel)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# API auth (local dev only — NEVER set in production)
DEV_API_KEY=dev_local_key_change_me

# Required in production (set APP_ENV=production explicitly)
APP_ENV=development
API_KEY_PEPPER=change_me_to_a_long_random_secret
DASHBOARD_SESSION_SECRET=change_me_to_a_long_random_secret
ADMIN_SECRET=change_me_for_global_blacklist_admin

# Which forwarded-IP header may be believed (per-IP rate limits depend on it).
#   vercel  — x-vercel-forwarded-for only (correct ONLY when deployed on Vercel)
#   generic — x-real-ip / x-forwarded-for only, and only behind a proxy that rewrites them
#   none    — believe nothing; every caller shares one bucket (safe default)
PROXY_HEADER_SOURCE=none
# Deprecated (2026-08-22): TRUST_PROXY_HEADERS / TRUST_GENERIC_FORWARDED_FOR.
# Still read when PROXY_HEADER_SOURCE is unset, but they cannot say WHICH header
# is trustworthy — off Vercel that guess made every IP limit bypassable.

# /decision key-less read window (AQ-053, 2026-09-07): 10 requests/min per IP with no
# Authorization header, same body as the keyed route. Set to 0 to require a key again.
# DECISION_KEYLESS_READ=1

# Cron auth (Vercel cron + manual triggers)
CRON_SECRET=change_me_cron_secret_min_32_chars

# Optional: separate RPC for batch indexers (falls back to BASE_RPC_URL)
# INDEXER_RPC_URL=https://base-mainnet.g.alchemy.com/v2/...

# Deep health flags indexer lag above N blocks (informational; does not force HTTP 503)
# HEALTH_INDEXER_LAG_BLOCKS=500000

# Closed beta: require invite code on /signup (omit for public beta)
# BETA_INVITE_CODE=your-secret-invite

# Public URL for Stripe redirects
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (public beta)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_SCALE=price_...

# Optional: skip on-chain reads in local dev (NEVER enable in production)
SKIP_CHAIN_READS=false

# eth_getLogs block range per RPC request (default 2000; raise if your RPC allows)
# GET_LOGS_CHUNK_BLOCKS=2000
# Optional delay between chunks (ms) for public RPC rate limits
# GET_LOGS_CHUNK_DELAY_MS=250

# Blockscout API for wallet history (Base mainnet)
BLOCKSCOUT_API_URL=https://base.blockscout.com/api
# BLOCKSCOUT_API_KEY=

# MCP server / x402 examples
VOUCH_API_URL=http://localhost:3000/api/v1
# VOUCH_API_KEY=vouch_live_...

# --- Observatory L1 (real purchases) — both OFF by default; enabling spends real funds ---
# OBSERVATORY_L1_ENABLED=true
# OBSERVATORY_WALLET_PRIVATE_KEY=0x...
# /playground の level:l1（デモ実購入）。観測所側フラグと二重ゲート。
# DEMO_L1_ENABLED=true

# --- On-chain publication & attestations — all OFF by default; enabling spends gas/fees ---
# REGISTRY_WRITES_ENABLED=true
# REGISTRY_OPERATOR_PRIVATE_KEY=0x...   # separate key from the purchase wallet
# REGISTRY_MAX_FEE_GWEI=0.5
# REGISTRY_WRITE_TIERS=C2,C3            # §7.4 の階層がこの集合に入る endpoint だけ書く（既定 C2,C3）
# REGISTRY_DAILY_MAX_WRITES=200         # 1 日（UTC）の台帳行数の上限。超えたら書かず理由をログ
# REGISTRY_MIN_BALANCE_WEI=500000000000000   # 0.0005 ETH。operator 残高がこれ未満なら書かず fail-loud
# 有効化前の見積もり（読み取り専用・鍵不要）: DATABASE_URL=... npm run registry:dryrun  → 直近 24h で「今 ON にしたら」何件・どの endpoint・推定ガスを JSON で出す
# SOLANA_ATTEST_ENABLED=true
# ANCHOR_WRITES_ENABLED=true
# --- Permissionless contribution intake (Phase 3.3 v0) ---
# CONTRIBUTIONS_ENABLED=true

# --- 2026-09-02 監査 §4: コードが読むのに未記載だった変数。値なし・1 行説明。 ---
# tests/docs-surface-parity.test.ts が「process.env.X ⊆ この一覧」を検査する。

# Webhook signing secrets are encrypted at rest with this KEK (falls back to API_KEY_PEPPER).
# WEBHOOK_SECRET_KEK=
# Previous KEK, kept readable during a rotation; remove once every secret is re-wrapped.
# WEBHOOK_SECRET_KEK_PREVIOUS=
# Public site URL (defaults to https://vet402.com); used for canonical / OG / JSON-LD.
# NEXT_PUBLIC_SITE_URL=
# Plausible analytics domain; unset = no analytics script is emitted.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Search Console verification token (a default is compiled in).
# GOOGLE_SITE_VERIFICATION=
# Force Secure cookies outside production (e.g. HTTPS dev proxy).
# FORCE_SECURE_COOKIES=false
# Alchemy key for wallet transfer history; ALCHEMY_API_URL overrides the derived base URL.
# ALCHEMY_API_KEY=
# ALCHEMY_API_URL=
# Per-request time budget (ms) for Alchemy reads.
# ALCHEMY_BUDGET_MS=
# Wallet-metrics walk budget (ms, default 18000) and per-counter budget (ms, default 3000).
# WALLET_METRICS_BUDGET_MS=
# WALLET_METRICS_COUNTER_BUDGET_MS=
# Parallel eth_getLogs chunks per indexer pass (1–8, default 4).
# GET_LOGS_CHUNK_CONCURRENCY=
# Minimum settlement size in USDC base units counted by the x402 ledgers (default 1000).
# X402_MIN_SETTLEMENT_UNITS=
# Agent id scored by /api/demo/score and the health probe (default 1).
# DEMO_AGENT_ID=
# Payee address the health scoring probe reads (default compiled in).
# HEALTH_PAYEE_ADDRESS=
# Health payee probe memo TTL in ms (default 60000). Test knob for reaching the
# stale-while-revalidate branch without waiting a minute; leave unset in production.
# HEALTH_PAYEE_PROBE_TTL_MS=
# /playground demo L1 purchases per UTC day (default 5, ceiling 25).
# DEMO_L1_DAILY_MAX=
# Hard cap per observatory L1 purchase in USDC base units (default 1000000 = $1, max 25000000).
# OBSERVATORY_L1_MAX_PURCHASE_UNITS=
# Solana: enable L1 purchases (default off), base58 secret key of the purchase wallet, RPC URL, and the settlement indexer (set to false to disable).
# OBSERVATORY_SOLANA_L1_ENABLED=false
# OBSERVATORY_SOLANA_SECRET_KEY=
# SOLANA_RPC_URL=
# OBSERVATORY_SOLANA_INDEX_ENABLED=
# Solana L1 daily cap in USD inside the shared $25 (default 2; lower only; 0 stops Solana purchases).
# L1_SOLANA_DAILY_CAP_USD=
# Arc (Circle's stablecoin L1, eip155:5042) L1 lane — off by default (2026-09-17). Same EOA as Base
# (OBSERVATORY_WALLET_PRIVATE_KEY), funded with Arc USDC (0x3600…) separately; gas on Arc is USDC.
# While off, Arc endpoints are never candidates and no ledger row is written for them.
# OBSERVATORY_ARC_L1_ENABLED=false
# Arc L1 daily cap in USD inside the shared $25 (default 2; lower only; 0 stops Arc purchases).
# L1_ARC_DAILY_CAP_USD=
# Per-lane candidate floor (2026-09-17): how many candidates of each capped lane (Solana, Arc) are
# put at the HEAD of every L1 batch regardless of demand order (default 5, ceiling 20, 0 = none).
# L1_LANE_FLOOR_PER_RUN=
# Arc RPC. The payer balance read falls back to the public https://rpc.mainnet.arc.io when unset;
# the settlement indexer (index-evm) and the on-chain re-read need it set and skip Arc quietly otherwise.
# ARC_RPC_URL=
# Tempo (MPP, 2026-09-17): enable L1 purchases on Tempo (default off; same EOA as Base, paid in USDC.e),
# the Tempo L1 daily cap in USD inside the shared $25 (default 2; lower only; 0 stops Tempo purchases),
# the Tempo JSON-RPC URL (no default: unset means the payer balance is unreadable so nothing is signed,
# settlement re-reads stay chain_not_yet_verifiable and the indexer skips Tempo as TEMPO_RPC_URL_unset;
# the public endpoint is https://rpc.tempo.xyz), and the MPP directory URL (default https://mpp.dev/api/services).
# OBSERVATORY_TEMPO_L1_ENABLED=false
# L1_TEMPO_DAILY_CAP_USD=
# TEMPO_RPC_URL=
# MPP_DIRECTORY_URL=
# Comma-separated chain:address ids treated as measurement wallets (wash_flag test) in the census.
# OBSERVATORY_TEST_WALLETS=
# Comma-separated payTo addresses vet402 itself operates; excluded from the catalog as self-listings.
# VET402_OPERATOR_PAYTO=
# Comma-separated account emails owned by the operator; excluded from the gate-2 usage report.
# SELF_ACCOUNT_EMAILS=
# Dormant guarantee product — keep unset; /api/v1/guarantee/quote answers 404 until true.
# GUARANTEE_UNDERWRITING_ENABLED=false
# MCP server per-request timeout in ms (default 10000; cannot be disabled).
# VOUCH_TIMEOUT_MS=
# Deprecated (2026-08-22) — read only when PROXY_HEADER_SOURCE is unset; see above.
# TRUST_PROXY_HEADERS=
# TRUST_GENERIC_FORWARDED_FOR=

# --- Outbound mail (Resend HTTP API) — record subscriptions / disputes (2026-09-02) ---
# Both unset = nothing is sent; subscriptions are still recorded and the cron logs mail_unset.
# RESEND_API_KEY=re_...
# MAIL_FROM=vet402 <records@vet402.com>

# Payer key for the MCP tool `pay_if_trusted` / the SDK's payOrRefuse. Optional:
# without it the gate still runs and refuses with `payer_not_configured` rather
# than signing. Never commit a real value; never print it. (2026-09-05)
# VOUCH_PAYER_PRIVATE_KEY=
# Solana payer for the MCP tool `pay_if_trusted` when `payee` is a base58 address (2026-09-15).
# solana-keygen JSON array or base64 of the 64-byte secret key; also needs SOLANA_RPC_URL and
# @solana/web3.js installed next to the MCP server. Without it a base58 payee refuses with
# `payer_not_configured`. Never commit a real value; never print it.
# VOUCH_SOLANA_PAYER_SECRET_KEY=
# Graph Gateway API key for the MCP tool `pay_if_trusted` when policy.evidence.source is
# "subgraph" or "both". Read from env only (never from tool input, so it never enters the
# model's context). Without it such a call refuses with `graph_key_not_configured`
# before reading anything. (2026-09-06)
# GRAPH_API_KEY=
# Operator's per-payment ceiling in USD for the MCP tools (2026-09-12 audit H-1). The effective
# limit is min(the tool call's maxPerTxUsd, this). **A model cannot raise it** — before this,
# `maxPerTxUsd` was tool input, so the ceiling was whatever the model wrote. Unset, or set to
# anything that is not a positive number, means $1 (the SDK's DEFAULT_MAX_PER_TX_USD); an
# unreadable value is never read as "no ceiling". A 402 above the ceiling refuses with
# `price_above_ceiling`, as before.
# VOUCH_MAX_PER_TX_USD=1

# Vercel が実行時に自動で入れるリージョン名（例: hnd1）。**運用者は設定しない。**
# health_snapshots.instance の前置に使うだけで、無ければ `local` になる。
# 読む場所: src/lib/health/instance-id.ts (2026-09-08)
# VERCEL_REGION=

# --- L1 declared query (2026-09-20) — OFF by default ---
# CAIP-2 allow list (comma separated, exact match, e.g. `xrpl:0`). Unset or empty = OFF for every chain.
# When the network of the accept being signed is listed, the PAID L1 request appends the query parameters the
# seller's own 402 declares in extensions.bazaar.info.input.queryParams (names and values as declared; nothing
# is invented). The unpaid request, the signed amount / payTo and the envelope's resource.url do not change.
# Tempo (MPP) is out of scope even if listed. Rules: declared-input.ts. Conditions for turning it on:
# docs/handoffs/CHANGELOG.md (2026-09-20).
# OBSERVATORY_L1_DECLARED_QUERY_NETWORKS=

# --- XRPL lane (2026-09-17) — OFF by default; enabling spends real RLUSD and XRP fees ---
# Enable L1 purchases on XRPL mainnet (xrpl:0). v1 pays RLUSD only (XRP / USDC-IOU walls are recorded, not paid).
# OBSERVATORY_XRPL_L1_ENABLED=false
# Family seed (s…) of the XRPL purchase wallet. Never commit a real value; never print it.
# OBSERVATORY_XRPL_SEED=
# XRPL JSON-RPC over HTTPS (e.g. https://s1.ripple.com:51234/). Required by the payer, the verifier and the
# settlement indexer — none of them falls back to a public node (same rule as BASE_RPC_URL / SOLANA_RPC_URL):
# unset → the runner does not sign (payer_unfunded: xrpl_rpc_unset), the verifier defers (rpc_unavailable),
# the indexer is skipped. Only scripts/xrpl-trustline.ts (run by the owner) defaults to s1.ripple.com.
# XRPL_RPC_URL=
# XRPL L1 daily cap in USD inside the shared $25 (default 2; lower only; 0 stops XRPL purchases).
# L1_XRPL_DAILY_CAP_USD=
# Set to false to disable the XRPL settlement indexer even when XRPL_RPC_URL is set.
# OBSERVATORY_XRPL_INDEX_ENABLED=
# Funding the XRPL payer (owner checklist): the account needs ≈1.5 XRP (1 XRP base reserve + 0.2 XRP
# for the RLUSD trust line + fees at 12 drops/tx), a trust line to the RLUSD issuer
# rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De (OBSERVATORY_XRPL_SEED=… npx tsx scripts/xrpl-trustline.ts),
# and an RLUSD balance (≈$2/day at the default cap). Fund with XRP only and convert on-ledger:
# `npx tsx scripts/xrpl-trustline.ts --swap-xrp 8` prints the quote and stops; add `--yes` to swap
# (self cross-currency Payment, DeliverMin = quote − 2%). The runner refuses to sign when RLUSD is short
# or XRP after reserve cannot cover the fee (log: observatory.l1.payer_unfunded).
