{
  "name": "agent-trust",
  "version": "0.1.0",
  "private": true,
  "description": "vet402 buys what x402 endpoints actually sell, verifies fulfillment against the seller's own declaration, and publishes the results with evidence.",
  "license": "MIT",
  "author": "KIZUNA Creation",
  "homepage": "https://vet402.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzmttkc/vet402.git"
  },
  "bugs": {
    "url": "https://github.com/kzmttkc/vet402/issues"
  },
  "keywords": [
    "x402",
    "erc-8004",
    "erc8004",
    "ai-agents",
    "agent-payments",
    "verification",
    "base",
    "onchain"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node scripts/report-test-gates.mjs && tsx --test tests/*.test.ts && npm run sdk:test && npm run middleware:test && npm run mcp:test",
    "test:db": "tsx --test --test-concurrency=1 --test-force-exit $(grep -l TEST_DATABASE_URL tests/*.test.ts)",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "predb:generate": "tsx scripts/db-preflight.ts",
    "db:generate": "drizzle-kit generate",
    "predb:push": "tsx scripts/db-preflight.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "api-key:create": "tsx scripts/create-api-key.ts",
    "check:env": "tsx scripts/check-production-env.ts",
    "indexer:funders": "tsx scripts/index-funders.ts",
    "indexer:owners": "tsx scripts/index-owners.ts",
    "indexer:feedback": "tsx scripts/index-feedback.ts",
    "indexer:outcomes": "tsx scripts/index-outcomes.ts",
    "cron:purge-logs": "tsx scripts/purge-logs.ts",
    "benchmark:scan": "tsx scripts/run-benchmark.ts",
    "backfill:payee": "tsx scripts/backfill-payee.ts",
    "correct:path-templates": "tsx scripts/correct-path-template-fails.ts",
    "gate2:report": "tsx scripts/gate2-report.ts",
    "registry:dryrun": "tsx scripts/registry-dryrun.ts",
    "setup:stripe": "tsx scripts/setup-stripe-products.ts",
    "setup:stripe-webhook": "tsx scripts/setup-stripe-webhook.ts",
    "mcp:build": "npm run build --prefix packages/mcp-server",
    "mcp:dev": "npm run dev --prefix packages/mcp-server",
    "mcp:test": "npm run test --prefix packages/mcp-server",
    "sdk:build": "npm run build --prefix packages/sdk",
    "sdk:test": "npm run test --prefix packages/sdk",
    "middleware:build": "npm run build --prefix packages/middleware",
    "middleware:test": "npm run test --prefix packages/middleware",
    "release:packages": "node scripts/release-packages.mjs",
    "x402:demo": "npm run demo --prefix examples/x402-trust-gate",
    "agentkit:demo": "npm run demo --prefix examples/agentkit-spend-guard",
    "indexer:settlements": "tsx scripts/index-settlements.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.3.1",
    "viem": "^2.55.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "overrides": {
    "@tailwindcss/postcss": {
      "postcss": "^8.5.26"
    }
  }
}
