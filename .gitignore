# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# ローカルのエージェント作業用（launch.json / worktrees）
/.claude/

# Gate2 ledger (contains external signup emails — PII, do not commit)
/state/

# typescript
*.tsbuildinfo
next-env.d.ts
logs/

# python (packages/python-sdk)
__pycache__/
*.egg-info/
.pytest_cache/
.venv/

# 2026-08-22: pytest / pip -e が生成する成果物が追跡されており、テストを1回
# 走らせるだけで作業ツリーが汚れていた（実際に汚れた）。ソースではない。
__pycache__/
*.py[cod]
*.egg-info/

# payOrRefuse の決定行（ローカル追記専用 JSONL・DEFAULT_DECISION_STORE）。
# 台帳は各実行環境のものであってリポの成果物ではない。
.vet402/
