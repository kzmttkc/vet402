# Supply-chain guard (security audit 2026-10-28 #3): never run dependency
# install scripts (preinstall/install/postinstall/prepare) on npm ci/install.
# Every install script in package-lock.json was checked and none is needed:
# esbuild and unrs-resolver only verify or re-download the platform binary
# that npm already installs as an optionalDependency; bufferutil and
# utf-8-validate load their bundled prebuilds (ws falls back to JS anyway);
# bigint-buffer falls back to pure JS; fsevents ships a prebuilt binary.
# Note: this also skips pre/post hooks of `npm run <x>`, so safety steps
# must be chained inside the script itself (see db:push / db:generate).
# npm only reads this file from the project it runs in; `npm ci --prefix <dir>`
# reads <dir>/.npmrc instead, so CI sets NPM_CONFIG_IGNORE_SCRIPTS=true in the
# workflow env and scripts/judge-check.sh exports the same value.
ignore-scripts=true
